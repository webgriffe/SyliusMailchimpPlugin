{% set customer = hookable_metadata.context.customer %}
{% if customer is defined and customer.mailchimpId is not null or customer.mailchimpSyncedAt is not null or customer.mailchimpError is not null %}
<div class="card">
    <div class="card-header">
        <h3 class="card-title">
            {{ ux_icon('tabler:mail') }}
            {{ 'webgriffe_sylius_mailchimp.ui.mailchimp'|trans }}
        </h3>
        <div class="card-actions">
            <a href="{{ path('webgriffe_sylius_mailchimp_contact_show', {'id': customer.id}) }}" class="btn btn-secondary">
                {{ ux_icon('tabler:user') }}
                {{ 'webgriffe_sylius_mailchimp.ui.view_contact_detail'|trans }}
            </a>
        </div>
    </div>
    <table class="table table-vcenter card-table">
        <tbody>
            {% set badge = mailchimp_sync_badge(customer) %}
            <tr>
                <td>{{ 'webgriffe_sylius_mailchimp.ui.sync_status'|trans }}</td>
                <td>
                    <span class="badge bg-{{ badge.color }} text-white">{{ badge.label }}</span>
                </td>
            </tr>
            {% if customer.mailchimpId %}
            <tr>
                <td>{{ 'webgriffe_sylius_mailchimp.ui.mailchimp_id'|trans }}</td>
                <td>
                    <code>{{ customer.mailchimpId }}</code>
                    <a href="{{ mailchimp_member_url(customer.mailchimpId) }}" target="_blank" rel="noopener noreferrer" class="btn btn-sm ms-2">
                        {{ ux_icon('tabler:external-link') }}
                        {{ 'webgriffe_sylius_mailchimp.ui.view_on_mailchimp'|trans }}
                    </a>
                </td>
            </tr>
            {% endif %}
            {% if customer.mailchimpSyncedAt %}
            <tr>
                <td>{{ 'webgriffe_sylius_mailchimp.ui.synced_at'|trans }}</td>
                <td>{{ customer.mailchimpSyncedAt|date('Y-m-d H:i:s') }}</td>
            </tr>
            {% endif %}
            {% if customer.mailchimpError %}
            <tr>
                <td>{{ 'webgriffe_sylius_mailchimp.ui.sync_error'|trans }}</td>
                <td class="text-danger">
                    <small><code>{{ customer.mailchimpError|slice(0, 300) }}{% if customer.mailchimpError|length > 300 %}…{% endif %}</code></small>
                </td>
            </tr>
            {% endif %}
        </tbody>
    </table>
</div>
{% endif %}
