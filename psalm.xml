<?xml version="1.0"?>
<psalm
    errorLevel="1"
    resolveFromConfigFile="true"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
    phpVersion="8.4"
>
    <projectFiles>
        <directory name="src" />
        <ignoreFiles>
            <directory name="vendor" />
            <!-- Makes Psalm crash (same as PHPStan) -->
            <file name="src/DependencyInjection/Configuration.php" />
        </ignoreFiles>
    </projectFiles>
    <plugins>
        <pluginClass class="Psalm\SymfonyPsalmPlugin\Plugin">
            <containerXml>var/cache/dev/Sylius_TestApplication_KernelDevDebugContainer.xml</containerXml>
            <containerXml>var/cache/test/Sylius_TestApplication_KernelTestDebugContainer.xml</containerXml>
        </pluginClass>
    </plugins>
    <issueHandlers>
        <!-- Public API methods are called by downstream code or later commits -->
        <PossiblyUnusedMethod>
            <errorLevel type="suppress">
                <directory name="src" />
            </errorLevel>
        </PossiblyUnusedMethod>
        <!-- Public API properties (readonly on VOs) are accessed by downstream code or later commits -->
        <PossiblyUnusedProperty>
            <errorLevel type="suppress">
                <directory name="src" />
            </errorLevel>
        </PossiblyUnusedProperty>
        <UnusedClass>
            <errorLevel type="suppress">
                <!-- Plugin entry-point classes are referenced by string in bundles.php -->
                <referencedClass name="Webgriffe\SyliusMailchimpPlugin\WebgriffeSyliusMailchimpPlugin" />
                <!-- Migrations are loaded by Doctrine by class name string -->
                <referencedClass name="DoctrineMigrations\*" />
                <!-- Model interfaces and traits are extension points used by integrator code -->
                <referencedClass name="Webgriffe\SyliusMailchimpPlugin\Model\*" />
                <!-- Repository traits are extension points used by integrator code -->
                <referencedClass name="Webgriffe\SyliusMailchimpPlugin\Doctrine\ORM\*" />
                <!-- Repository interfaces are extension points -->
                <referencedClass name="Webgriffe\SyliusMailchimpPlugin\Repository\*" />
                <!-- Client service is wired via DI container alias -->
                <referencedClass name="Webgriffe\SyliusMailchimpPlugin\Client\*" />
                <!-- Provider/Resolver classes are wired via DI container -->
                <referencedClass name="Webgriffe\SyliusMailchimpPlugin\Provider\*" />
                <referencedClass name="Webgriffe\SyliusMailchimpPlugin\Resolver\*" />
                <!-- Mapper classes are wired via DI container -->
                <referencedClass name="Webgriffe\SyliusMailchimpPlugin\Mapper\*" />
                <!-- MessageHandler classes are invoked by Messenger -->
                <referencedClass name="Webgriffe\SyliusMailchimpPlugin\MessageHandler\*" />
                <!-- Enqueuer classes are wired via DI container -->
                <referencedClass name="Webgriffe\SyliusMailchimpPlugin\Enqueuer\*" />
                <!-- EventSubscriber classes are wired via DI container -->
                <referencedClass name="Webgriffe\SyliusMailchimpPlugin\EventSubscriber\*" />
                <!-- Controller classes are wired via DI container -->
                <referencedClass name="Webgriffe\SyliusMailchimpPlugin\Controller\*" />
                <!-- Updater classes are wired via DI container -->
                <referencedClass name="Webgriffe\SyliusMailchimpPlugin\Updater\*" />
                <!-- Form extension classes are wired via DI container -->
                <referencedClass name="Webgriffe\SyliusMailchimpPlugin\Form\*" />
                <!-- Command classes are wired via DI container -->
                <referencedClass name="Webgriffe\SyliusMailchimpPlugin\Command\*" />
            </errorLevel>
        </UnusedClass>
        <!-- Symfony/Sylius base types are not annotated as generic; suppress for extension types -->
        <MissingTemplateParam>
            <errorLevel type="suppress">
                <directory name="src/Form" />
                <directory name="src/Repository" />
            </errorLevel>
        </MissingTemplateParam>
    </issueHandlers>
</psalm>
